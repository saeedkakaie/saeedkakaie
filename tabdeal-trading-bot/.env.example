# کلیدهای API صرافی تبدیل - هرگز این فایل را با مقادیر واقعی کامیت نکنید
# فایل .env را از روی همین فایل بسازید: cp .env.example .env
TABDEAL_API_KEY=
TABDEAL_API_SECRET=

# ربات به‌جای یک نماد ثابت، خودش پرفعالیت‌ترین نمادهای بازار با این دارایی
# مبنا را پیدا و دنبال می‌کند (مثلا IRT برای بازار تومان/ریال). تعداد نماد
# دیگر قابل تنظیم دستی نیست: ربات خودش تا سقف منطقی (پیش‌فرض ۴۰ نماد در
# src/market_scanner.py) پرفعالیت‌ترین‌ها را انتخاب می‌کند.
QUOTE_ASSET=IRT

# هر چند دقیقه یک‌بار لیست نمادهای پرفعالیت دوباره محاسبه شود
WATCHLIST_REFRESH_MINUTES=60

# ربات با اختیار کامل تصمیم می‌گیرد: نه سقف تعداد پوزیشن هم‌زمان دارد، نه
# مبلغ ثابت هر معامله، نه سقف تعداد معامله در روز. در هر چرخه، موجودی آزاد
# QUOTE_ASSET را متناسب با قدرت سیگنال (confidence) بین نمادهایی که هم‌زمان
# سیگنال خرید می‌دهند تقسیم می‌کند؛ اگر فقط یک نماد سیگنال بدهد، ممکن است
# کل موجودی آزاد را به همان یک کوین اختصاص دهد. جزئیات در src/bot.py.

# دقت اعشار پیش‌فرض مقدار (quantity) سفارش. چون ربات خودش چند نماد را
# هم‌زمان معامله می‌کند، برای هر نماد جداگانه سعی می‌کند دقت واقعی را از
# exchange_info بخواند؛ این مقدار فقط زمانی استفاده می‌شود که آن مقدار
# برای یک نماد پیدا نشود. برای بررسی مقادیر واقعی هر نماد، اجرا کنید:
# python scripts/inspect_api.py
QUANTITY_PRECISION=6

# کارمزد هر پای معامله (خرید یا فروش) به درصد. عدد پیش‌فرض یک تخمین رایج
# است، نه نرخ واقعی تبدیل - حتما از سطح کارمزد واقعی حساب خودتان
# (داشبورد تبدیل) مطمئن شوید و اینجا اصلاح کنید. در محاسبه‌ی سود/زیان،
# دو برابر این عدد (خرید + فروش) کم می‌شود.
TRADING_FEE_PERCENT=0.35

# مدیریت ریسک - STOP_LOSS_PERCENT/TAKE_PROFIT_PERCENT فقط زمانی استفاده
# می‌شوند که استراتژی نتواند حد ضرر/سود پویا محاسبه کند (مثلا داده کافی
# برای نوسان‌سنجی نباشد). MAX_DAILY_LOSS_PERCENT تنها مرز ایمنی باقی‌مانده
# در کنار حد ضرر/سود هر پوزیشن است: اگر مجموع ضرر تجمعی امروز از این عدد
# عبور کند، ربات مدار قطع را فعال می‌کند و تا فردا پوزیشن جدید باز نمی‌کند.
STOP_LOSS_PERCENT=2
TAKE_PROFIT_PERCENT=3
MAX_DAILY_LOSS_PERCENT=5

# استراتژی پیش‌فرض فعلی TechnicalStrategy است (ترکیب RSI + MACD + باند
# بولینگر + Stochastic + روند EMA، با حد ضرر/سود پویا بر اساس نوسان بازار).
# این دو مقدار فقط برای SmaCrossoverStrategy (استراتژی ساده‌تر جایگزین در
# src/strategy.py) استفاده می‌شوند.
SMA_FAST_PERIOD=5
SMA_SLOW_PERIOD=20

# فیلتر سبک اخبار (اختیاری) - از endpoint عمومی و رایگان CryptoCompare
# (بدون نیاز به ثبت‌نام یا کلید) برای رد کردن سیگنال خرید روی خبر بد
# استفاده می‌کند. اگر NEWS_ENABLED=false باشد، این فیلتر خنثی است و ربات
# بدون آن هم کامل کار می‌کند. NEWS_API_KEY کاملا اختیاری است (فقط برای
# محدودیت نرخ بالاتر، از cryptocompare.com قابل دریافت).
NEWS_ENABLED=false
NEWS_API_KEY=
NEWS_CACHE_MINUTES=30

# فاصله هر چرخه بررسی قیمت (ثانیه)
POLL_INTERVAL_SECONDS=30

# true = فقط شبیه‌سازی و لاگ، هیچ سفارش واقعی ثبت نمی‌شود (پیشنهاد می‌شود حتما اول با true تست کنید)
DRY_RUN=true

# true = وقتی webapp/app.py مستقیما اجرا شود (مثلا با run.sh یا موقع بوت
# گوشی)، ربات بدون نیاز به کلیک دستی روی دکمه «شروع» در داشبورد خودش
# معامله را شروع می‌کند. برای معاملات واقعی کاملا خودکار (بدون هیچ کاری از
# طرف شما، حتی بعد از ری‌استارت گوشی) این را true بگذارید و همراه با
# اسکریپت بوت Termux (بخش «شروع کاملا خودکار» در README) استفاده کنید.
AUTO_START=false

LOG_LEVEL=INFO
