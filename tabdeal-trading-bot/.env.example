# کلیدهای API صرافی تبدیل - هرگز این فایل را با مقادیر واقعی کامیت نکنید
# فایل .env را از روی همین فایل بسازید: cp .env.example .env
TABDEAL_API_KEY=
TABDEAL_API_SECRET=

# ربات به‌جای یک نماد ثابت، خودش پرفعالیت‌ترین نمادهای بازار با این دارایی
# مبنا را پیدا و دنبال می‌کند (مثلا IRT برای بازار تومان/ریال)
QUOTE_ASSET=IRT

# چند نماد پرفعالیت هم‌زمان زیر نظر گرفته شود
WATCHLIST_SIZE=15

# هر چند دقیقه یک‌بار لیست نمادهای پرفعالیت دوباره محاسبه شود
WATCHLIST_REFRESH_MINUTES=60

# حداکثر تعداد پوزیشن بازی که هم‌زمان مجاز است (سرمایه درگیر = این عدد × QUOTE_ORDER_AMOUNT)
MAX_CONCURRENT_POSITIONS=3

# مقدار سرمایه هر معامله بر حسب دارایی quote (مثلا تومان/ریال یا USDT بسته به نماد)
QUOTE_ORDER_AMOUNT=500000

# تعداد رقم اعشار مجاز برای مقدار (quantity) دارایی base این نماد
# قبل از فعال کردن ربات، با scripts/inspect_api.py مقدار دقیق را از exchangeInfo استخراج و اینجا تنظیم کنید
QUANTITY_PRECISION=6

# کارمزد هر پای معامله (خرید یا فروش) به درصد. عدد پیش‌فرض یک تخمین رایج
# است، نه نرخ واقعی تبدیل - حتما از سطح کارمزد واقعی حساب خودتان
# (داشبورد تبدیل) مطمئن شوید و اینجا اصلاح کنید. در محاسبه‌ی سود/زیان،
# دو برابر این عدد (خرید + فروش) کم می‌شود.
TRADING_FEE_PERCENT=0.35

# مدیریت ریسک - این مقادیر فقط زمانی استفاده می‌شوند که استراتژی نتواند
# حد ضرر/سود پویا محاسبه کند (مثلا داده کافی برای نوسان‌سنجی نباشد)
STOP_LOSS_PERCENT=2
TAKE_PROFIT_PERCENT=3
MAX_DAILY_LOSS_PERCENT=5
MAX_TRADES_PER_DAY=10

# استراتژی پیش‌فرض فعلی TechnicalStrategy است (ترکیب RSI + MACD + باند
# بولینگر + Stochastic + روند EMA، با حد ضرر/سود پویا بر اساس نوسان بازار).
# این دو مقدار فقط برای SmaCrossoverStrategy (استراتژی ساده‌تر جایگزین در
# src/strategy.py) استفاده می‌شوند.
SMA_FAST_PERIOD=5
SMA_SLOW_PERIOD=20

# فیلتر سبک اخبار (اختیاری) - از CryptoPanic (cryptopanic.com، دارای سطح
# رایگان) برای رد کردن سیگنال خرید روی خبر بد استفاده می‌کند. اگر
# NEWS_ENABLED=false یا توکن خالی باشد، این فیلتر خنثی است و ربات بدون آن
# هم کامل کار می‌کند.
NEWS_ENABLED=false
CRYPTOPANIC_API_TOKEN=
NEWS_CACHE_MINUTES=30

# فاصله هر چرخه بررسی قیمت (ثانیه)
POLL_INTERVAL_SECONDS=30

# true = فقط شبیه‌سازی و لاگ، هیچ سفارش واقعی ثبت نمی‌شود (پیشنهاد می‌شود حتما اول با true تست کنید)
DRY_RUN=true

LOG_LEVEL=INFO
